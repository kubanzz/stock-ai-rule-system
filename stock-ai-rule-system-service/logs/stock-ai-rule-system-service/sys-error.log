                )) IN ('INTEGER', 'DOUBLE')
                THEN CAST(
                    JSON_UNQUOTE(JSON_EXTRACT(
                        newer.payload_json, '$.auditValue'
                    )) AS DECIMAL(30, 10)
                )
            END
        ) IS NOT NULL
        AND (newer.available_at > o.available_at
          OR (newer.available_at = o.available_at AND newer.id > o.id))
  )
